# ==============================================================================
# TripMate AI - Environment Configuration
# ==============================================================================

# 1. Groq API Key (REQUIRED)
# Powers LLM reasoning, supervisor routing, itinerary synthesis, and budget analysis.
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Tavily Search API Key (RECOMMENDED for Live Hotel & Destination Search)
# Powers the Tavily MCP Server for live web and hotel search.
# Get a free API key at: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# 3. OpenWeather API Key (RECOMMENDED for Live Weather & Forecasts)
# Powers the Custom Weather MCP Server.
# Get a free API key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 4. AviationStack API Key (RECOMMENDED for Live Flight/Airline/Airport Data)
# Powers the AviationStack MCP Server via uvx.
# Get a free API key at: https://aviationstack.com
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# 5. PostgreSQL Database URL (OPTIONAL - MemorySaver will be used as fallback)
# Used by LangGraph PostgresSaver to persist conversation state and checkpoints.
# Compatible with Neon, Supabase, Render, or local PostgreSQL.
# Example: postgresql://user:password@ep-xyz.region.neon.tech/dbname?sslmode=require
DATABASE_URL=

# 6. LangSmith Observability & Tracing (OPTIONAL)
# Enable tracing for debugging LangGraph agent steps.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGSMITH_PROJECT=TripMate-AI
